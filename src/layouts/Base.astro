---
import '../styles/global.css';
import { COPY, LANGS, langPath, HREFLANG, type Lang } from '../data/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];

// URL absoluta = site + base + langPath. `Astro.site` y `base` vienen de
// astro.config.mjs. El día que migremos a micaelapuig.com sin base, esto
// sigue funcionando — alcanza con cambiar `site` y borrar `base` ahí.
const SITE = Astro.site ?? new URL('https://micaelapuig.com');
const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const ROOT = new URL(BASE, SITE).toString();           // "https://.../micapuig-site/"
const absUrl = (lp: string) => ROOT + lp.replace(/^\//, '');
const canonical = absUrl(langPath(lang));
const ogImage = absUrl('og-image.jpg');

// JSON-LD Person schema — le dice a Google "esta página es la artista X"
const personLD = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Micaela Puig',
  givenName: 'Micaela',
  familyName: 'Puig',
  url: canonical,
  image: ogImage,
  jobTitle: lang === 'en' ? 'Visual artist & printmaker' : (lang === 'pt' ? 'Artista visual e gravadora' : 'Artista visual y grabadora'),
  description: t.metaDescription,
  birthPlace: { '@type': 'Place', name: 'Argentina' },
  birthDate: '1976',
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
  sameAs: [
    'https://www.instagram.com/micapuig/',
  ],
  knowsAbout: ['Printmaking', 'Drawing', 'Painting', 'Collage', 'Video art', 'Visual arts'],
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />

    <link rel="canonical" href={canonical} />
    {LANGS.map(l => (
      <link rel="alternate" hreflang={HREFLANG[l]} href={absUrl(langPath(l))} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absUrl('/')} />

    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : (lang === 'pt' ? 'pt_BR' : 'es_AR')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Micaela Puig — díptico en blanco y rojo, serie Aranka" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.metaTitle} />
    <meta name="twitter:description" content={t.metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personLD)} />
  </head>
  <body>
    <slot />
  </body>
</html>
