---
import '../styles/global.css';
import { COPY, LANGS, langPath, HREFLANG, type Lang } from '../data/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];

const SITE = (Astro.site ?? new URL('https://micaelapuig.com')).toString().replace(/\/$/, '');
const canonical = `${SITE}${langPath(lang)}`;
const ogImage = `${SITE}/og-image.jpg`;

const personLD = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Micaela Puig',
  givenName: 'Micaela',
  familyName: 'Puig',
  url: `${SITE}/`,
  image: ogImage,
  jobTitle: lang === 'en'
    ? 'Visual artist & printmaker'
    : (lang === 'pt' ? 'Artista visual e gravadora' : 'Artista visual y grabadora'),
  description: t.metaDescription,
  nationality: { '@type': 'Country', name: 'Argentina' },
  birthPlace: { '@type': 'Place', name: 'Argentina' },
  birthDate: '1976',
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
  knowsLanguage: ['Spanish', 'Portuguese'],
  sameAs: ['https://www.instagram.com/micapuig/'],
  knowsAbout: ['Printmaking', 'Engraving', 'Drawing', 'Collage', 'Photography', 'Video art', 'Visual arts', 'Contemporary art'],
  hasOccupation: {
    '@type': 'Occupation',
    name: lang === 'pt' ? 'Artista visual e gravadora' : (lang === 'en' ? 'Visual artist & printmaker' : 'Artista visual y grabadora'),
    occupationLocation: { '@type': 'City', name: 'São Paulo' },
  },
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f0f0f0" />

    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <meta name="keywords" content="Micaela Puig, artista visual, grabadora, São Paulo, grabado contemporáneo, printmaker, arte contemporáneo" />
    <meta name="author" content="Micaela Puig" />

    <link rel="canonical" href={canonical} />
    {LANGS.map(l => (
      <link rel="alternate" hreflang={HREFLANG[l]} href={`${SITE}${langPath(l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />

    <meta property="og:site_name" content="Micaela Puig" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : (lang === 'pt' ? 'pt_BR' : 'es_AR')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Micaela Puig — díptico en blanco y rojo, serie Aranka" />
    <meta property="profile:first_name" content="Micaela" />
    <meta property="profile:last_name" content="Puig" />
    <meta property="profile:username" content="micapuig" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.metaTitle} />
    <meta name="twitter:description" content={t.metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(personLD)} />
  </head>
  <body>
    <slot />
  </body>
</html>
